---
const getFormattedDate = (dObj) => {
  return `${dObj.getFullYear()}-${String(dObj.getMonth() + 1).padStart(2, '0')}-${String(dObj.getDate()).padStart(2, '0')}`;
};

const url = new URL(Astro.request.url);
let view = url.searchParams.get('v') || 'month';
if (!['month', 'week', 'day'].includes(view)) view = 'month';

let dateParam = url.searchParams.get('d');
let anchor = dateParam ? new Date(dateParam) : new Date();
if (isNaN(anchor.getTime())) anchor = new Date();

const y = anchor.getFullYear();
const m = anchor.getMonth();
const d = anchor.getDate();

let displayDays = [];
let prevAnchor, nextAnchor, headerTitle, queryStart, queryEnd;

if (view === 'month') {
  const daysInMonth = new Date(y, m + 1, 0).getDate();
  const firstDay = new Date(y, m, 1).getDay();
  const startingBlanks = firstDay === 0 ? 6 : firstDay - 1;
  
  for (let i = 0; i < startingBlanks; i++) displayDays.push(null);
  for (let i = 1; i <= daysInMonth; i++) displayDays.push(new Date(y, m, i));
  
  prevAnchor = new Date(y, m - 1, 1);
  nextAnchor = new Date(y, m + 1, 1);
  headerTitle = anchor.toLocaleString('en-GB', { month: 'long', year: 'numeric' });
  
  queryStart = getFormattedDate(new Date(y, m, 1));
  queryEnd = getFormattedDate(new Date(y, m + 1, 0));
} 
else if (view === 'week') {
  const dayOfWeek = anchor.getDay();
  const diffToMonday = anchor.getDate() - dayOfWeek + (dayOfWeek === 0 ? -6 : 1);
  const startOfWeek = new Date(y, m, diffToMonday);
  
  for (let i = 0; i < 7; i++) {
    displayDays.push(new Date(startOfWeek.getFullYear(), startOfWeek.getMonth(), startOfWeek.getDate() + i));
  }
  
  prevAnchor = new Date(startOfWeek.getFullYear(), startOfWeek.getMonth(), startOfWeek.getDate() - 7);
  nextAnchor = new Date(startOfWeek.getFullYear(), startOfWeek.getMonth(), startOfWeek.getDate() + 7);
  
  const endOfWeek = displayDays[6];
  let monthStr = startOfWeek.toLocaleString('en-GB', { month: 'short' });
  if (startOfWeek.getMonth() !== endOfWeek.getMonth()) {
    monthStr += ` / ${endOfWeek.toLocaleString('en-GB', { month: 'short' })}`;
  }
  headerTitle = `Week of ${startOfWeek.getDate()} ${monthStr} ${startOfWeek.getFullYear()}`;
  
  queryStart = getFormattedDate(startOfWeek);
  queryEnd = getFormattedDate(endOfWeek);
} 
else if (view === 'day') {
  displayDays.push(new Date(y, m, d));
  prevAnchor = new Date(y, m, d - 1);
  nextAnchor = new Date(y, m, d + 1);
  headerTitle = anchor.toLocaleString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
  
  queryStart = getFormattedDate(anchor);
  queryEnd = queryStart;
}

const prevUrl = `/?v=${view}&d=${getFormattedDate(prevAnchor)}`;
const nextUrl = `/?v=${view}&d=${getFormattedDate(nextAnchor)}`;

const db = Astro.locals.runtime.env.DB;
const { results: rawEvents } = await db
  .prepare('SELECT * FROM events WHERE event_date >= ? AND event_date <= ? ORDER BY event_date ASC, start_time ASC')
  .bind(queryStart, queryEnd)
  .all();

const calendarDays = displayDays.map(dateObj => {
  if (dateObj === null) return null;
  const dateStr = getFormattedDate(dateObj);
  return {
    date: dateStr,
    dayNum: dateObj.getDate(),
    events: rawEvents.filter(e => e.event_date === dateStr)
  };
});

const getCategoryStyles = (category) => {
  switch (category) {
    case 'West Ham': return 'bg-[#7A263A] text-white border-l-[4px] border-[#1BB1E7]';
    case 'Appointment': return 'bg-amber-100 text-amber-900 border-l-[4px] border-amber-500';
    case 'Social': return 'bg-emerald-100 text-emerald-900 border-l-[4px] border-emerald-500';
    case 'Ministry': return 'bg-indigo-100 text-indigo-900 border-l-[4px] border-indigo-500';
    case 'Work': return 'bg-slate-200 text-slate-800 border-l-[4px] border-slate-500';
    default: return 'bg-slate-50 border border-slate-200 text-slate-800';
  }
};
---

<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>J+T Calendar</title>
    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="apple-touch-icon" href="/icon.svg" />
    <meta name="theme-color" content="#0f172a" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="J+T Calendar" />
  </head>
  <body class="bg-slate-100 text-slate-900 font-sans antialiased pb-24">
    
    <header class="bg-slate-900 text-white sticky top-0 z-10 shadow-md safe-top">
      <div class="max-w-6xl mx-auto px-3 py-3 flex items-center justify-between">
        <a href={prevUrl} class="p-2 bg-slate-800 rounded-lg hover:bg-slate-700 font-bold flex-shrink-0">&lt;</a>
        
        <div class="flex-1 flex flex-col items-center justify-center mx-2 relative">
          <div class="text-base sm:text-lg md:text-xl font-black text-white text-center leading-tight mb-1">{headerTitle}</div>
          <input 
            type="date" 
            id="date-selector"
            value={getFormattedDate(anchor)} 
            class="bg-slate-800 text-slate-300 font-bold text-[10px] sm:text-xs rounded-lg px-2 py-1 text-center focus:outline-none focus:ring-2 focus:ring-emerald-500 cursor-pointer appearance-none"
          />
        </div>

        <a href={nextUrl} class="p-2 bg-slate-800 rounded-lg hover:bg-slate-700 font-bold flex-shrink-0">&gt;</a>
      </div>
      
      <div class="max-w-6xl mx-auto px-3 pb-3 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
        
        <div class="flex bg-slate-800 rounded-lg p-1 shrink-0 w-full sm:w-auto justify-between">
          <a href={`/?v=day&d=${getFormattedDate(anchor)}`} class={`px-4 py-1.5 rounded-md text-xs font-bold text-center flex-1 sm:flex-none ${view === 'day' ? 'bg-emerald-500 text-white shadow-sm' : 'text-slate-300 hover:text-white'}`}>Day</a>
          <a href={`/?v=week&d=${getFormattedDate(anchor)}`} class={`px-4 py-1.5 rounded-md text-xs font-bold text-center flex-1 sm:flex-none ${view === 'week' ? 'bg-emerald-500 text-white shadow-sm' : 'text-slate-300 hover:text-white'}`}>Week</a>
          <a href={`/?v=month&d=${getFormattedDate(anchor)}`} class={`px-4 py-1.5 rounded-md text-xs font-bold text-center flex-1 sm:flex-none ${view === 'month' ? 'bg-emerald-500 text-white shadow-sm' : 'text-slate-300 hover:text-white'}`}>Month</a>
        </div>

        <div class="flex gap-2 overflow-x-auto no-scrollbar w-full sm:w-auto pb-1 sm:pb-0 items-center">
          <button data-person="All" class="filter-btn px-4 py-1.5 rounded-full bg-white text-slate-900 font-bold text-xs ring-2 ring-offset-2 ring-slate-900 ring-offset-slate-900 whitespace-nowrap">All</button>
          <button data-person="Family" class="filter-btn px-4 py-1.5 rounded-full bg-slate-700 text-white font-bold text-xs whitespace-nowrap">Family</button>
          <button data-person="Josh" class="filter-btn px-4 py-1.5 rounded-full bg-blue-600 text-white font-bold text-xs whitespace-nowrap">Josh</button>
          <button data-person="Tanya" class="filter-btn px-4 py-1.5 rounded-full bg-pink-600 text-white font-bold text-xs whitespace-nowrap">Tanya</button>
          <button data-person="Anelise" class="filter-btn px-4 py-1.5 rounded-full bg-purple-500 text-white font-bold text-xs whitespace-nowrap">Anelise</button>
          
          <div class="w-px h-6 bg-slate-700 shrink-0 mx-1"></div>
          
          <div class="flex items-center gap-2 shrink-0 bg-slate-800 rounded-full px-3 py-1.5">
            <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">Zoom</span>
            <input type="range" id="zoom-slider" min="0.3" max="1.5" step="0.05" value="1" class="w-20 sm:w-24 accent-emerald-500" />
          </div>
        </div>
      </div>
    </header>

    <main class="max-w-6xl mx-auto p-0 sm:p-4">
      
      <div class={`${view !== 'day' ? 'overflow-x-auto w-full bg-white shadow-sm sm:rounded-xl sm:border border-slate-300' : ''}`}>
        <div id="calendar-grid" class={`${view !== 'day' ? 'min-w-[1050px]' : ''}`}>
          
          {view !== 'day' && (
            <div class="grid grid-cols-7 bg-slate-100 font-bold text-slate-500 text-center uppercase text-[10px] tracking-widest border-b border-slate-300">
              <div class="border-r border-slate-300 py-2">Mon</div>
              <div class="border-r border-slate-300 py-2">Tue</div>
              <div class="border-r border-slate-300 py-2">Wed</div>
              <div class="border-r border-slate-300 py-2">Thu</div>
              <div class="border-r border-slate-300 py-2">Fri</div>
              <div class="border-r border-slate-300 py-2">Sat</div>
              <div class="py-2">Sun</div>
            </div>
          )}
          
          <div class={`grid ${view === 'day' ? 'grid-cols-1 max-w-2xl mx-auto gap-4 p-4' : 'grid-cols-7'}`}>
            {calendarDays.map((day, index) => {
              const isLastInRow = (index + 1) % 7 === 0;
              return day === null ? (
                <div class={`bg-slate-50 min-h-[140px] border-b border-slate-300 ${!isLastInRow ? 'border-r' : ''}`}></div>
              ) : (
                <div class={`bg-white min-h-[140px] flex flex-col ${view === 'day' ? 'rounded-2xl shadow-sm border border-slate-200 p-4' : `p-1.5 border-b border-slate-300 ${!isLastInRow ? 'border-r' : ''}`}`}>
                  <div class="flex justify-between items-center mb-1">
                    <span class={`font-bold ${view === 'day' ? 'text-slate-400 text-base' : 'text-slate-400 text-xs'}`}>{day.dayNum}</span>
                    {view === 'day' && <span class="font-bold text-slate-300 text-sm uppercase">{new Date(day.date).toLocaleString('en-GB', { weekday: 'long' })}</span>}
                  </div>
                  <div class="flex flex-col gap-1 flex-1 overflow-y-auto no-scrollbar">
                    {day.events.map(event => (
                      <div data-assigned={event.assigned_to || 'Family'} class={`event-item text-[11px] p-1.5 rounded-sm leading-tight break-words whitespace-normal ${getCategoryStyles(event.category)}`}>
                        <div class="font-bold">{event.title}</div>
                        {event.start_time && <div class="opacity-90 text-[10px] mt-0.5">{event.start_time}</div>}
                        {view === 'day' && event.notes && <div class="opacity-80 italic mt-1">{event.notes}</div>}
                      </div>
                    ))}
                  </div>
                </div>
              )
            })}
          </div>

        </div>
      </div>

    </main>

    <button id="open-add-modal" class="fixed bottom-6 right-6 w-14 h-14 bg-emerald-500 hover:bg-emerald-600 text-white rounded-full shadow-lg shadow-emerald-500/30 flex items-center justify-center text-3xl font-light transition-transform active:scale-95 z-20 pb-1">
      +
    </button>

    <div id="add-modal" class="hidden fixed inset-0 z-50 flex items-end sm:items-center justify-center bg-slate-900/40 backdrop-blur-sm p-4 safe-bottom">
      <div class="bg-white w-full max-w-md rounded-3xl shadow-2xl overflow-hidden animate-slide-up">
        <div class="bg-slate-900 px-6 py-4 flex justify-between items-center">
          <h2 class="text-white font-black text-lg">Add New Plan</h2>
          <button id="close-modal" class="text-slate-400 hover:text-white font-bold text-xl">&times;</button>
        </div>
        
        <form id="add-event-form" class="p-6 flex flex-col gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-500 uppercase mb-1">What is happening?</label>
            <input type="text" name="title" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 font-bold text-slate-900 focus:outline-none focus:ring-2 focus:ring-emerald-500" placeholder="e.g. Dinner with the Bucklands" />
          </div>
          
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Date</label>
              <input type="date" name="event_date" required class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 font-bold text-slate-900 focus:outline-none focus:ring-2 focus:ring-emerald-500" value={getFormattedDate(anchor)} />
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Time</label>
              <input type="time" name="start_time" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 font-bold text-slate-900 focus:outline-none focus:ring-2 focus:ring-emerald-500" />
            </div>
          </div>
          
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Who</label>
              <select name="assigned_to" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 font-bold text-slate-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 appearance-none">
                <option value="Family">Family</option>
                <option value="Josh">Josh</option>
                <option value="Tanya">Tanya</option>
                <option value="Anelise">Anelise</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Category</label>
              <select name="category" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 font-bold text-slate-900 focus:outline-none focus:ring-2 focus:ring-emerald-500 appearance-none">
                <option value="General">General</option>
                <option value="Social">Social</option>
                <option value="Appointment">Appointment</option>
                <option value="West Ham">West Ham</option>
                <option value="Ministry">Ministry</option>
                <option value="Work">Work</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Notes (Optional)</label>
            <input type="text" name="notes" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 font-bold text-slate-900 focus:outline-none focus:ring-2 focus:ring-emerald-500" placeholder="Location, reminders, etc" />
          </div>
          
          <button type="submit" class="mt-2 w-full bg-slate-900 text-white font-black text-lg py-4 rounded-xl shadow-lg hover:bg-slate-800 transition-colors">
            Save to Calendar
          </button>
        </form>
      </div>
    </div>

    <style>
      .no-scrollbar::-webkit-scrollbar { display: none; }
      .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
      .safe-top { padding-top: env(safe-area-inset-top); }
      .safe-bottom { padding-bottom: env(safe-area-inset-bottom); }
      
      input[type="date"]::-webkit-calendar-picker-indicator {
        filter: invert(1);
        opacity: 0.7;
        cursor: pointer;
      }

      @keyframes slideUp {
        from { transform: translateY(100%); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
      }
      .animate-slide-up { animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    </style>

    <script>
      const zoomSlider = document.getElementById('zoom-slider');
      const calendarGrid = document.getElementById('calendar-grid');

      if (zoomSlider && calendarGrid) {
        const savedZoom = localStorage.getItem('calendar-zoom') || '1';
        zoomSlider.value = savedZoom;
        calendarGrid.style.zoom = savedZoom;

        zoomSlider.addEventListener('input', (e) => {
          calendarGrid.style.zoom = e.target.value;
          localStorage.setItem('calendar-zoom', e.target.value);
        });
      }

      const urlParams = new URLSearchParams(window.location.search);
      const currentView = urlParams.get('v') || 'month';

      const dateSelector = document.getElementById('date-selector');
      dateSelector.addEventListener('change', (e) => {
        window.location.href = `/?v=${currentView}&d=${e.target.value}`;
      });

      const modal = document.getElementById('add-modal');
      const openBtn = document.getElementById('open-add-modal');
      const closeBtn = document.getElementById('close-modal');
      const form = document.getElementById('add-event-form');
      const filterBtns = document.querySelectorAll('.filter-btn');

      openBtn.addEventListener('click', () => modal.classList.remove('hidden'));
      
      closeBtn.addEventListener('click', (e) => {
        e.preventDefault();
        modal.classList.add('hidden');
      });

      let activeFilter = 'All';

      filterBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          filterBtns.forEach(b => {
            b.classList.remove('ring-2', 'ring-offset-2', 'ring-slate-900');
            if (b.dataset.person !== 'All') {
              b.classList.add('opacity-50');
            }
          });
          
          const target = e.currentTarget;
          target.classList.add('ring-2', 'ring-offset-2', 'ring-slate-900');
          target.classList.remove('opacity-50');
          
          activeFilter = target.dataset.person;
          
          document.querySelectorAll('.event-item').forEach(el => {
            const assigned = el.dataset.assigned || 'Family';
            if (activeFilter === 'All' || assigned === activeFilter) {
              el.style.display = 'block';
            } else {
              el.style.display = 'none';
            }
          });
        });
      });

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const submitBtn = form.querySelector('button[type="submit"]');
        const originalText = submitBtn.innerText;
        submitBtn.innerText = 'Saving...';
        submitBtn.disabled = true;

        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());
        
        try {
          const res = await fetch('/api/events.json', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });
          
          if (res.ok) {
            window.location.reload();
          } else {
            alert('Failed to save event. Check the network tab.');
            submitBtn.innerText = originalText;
            submitBtn.disabled = false;
          }
        } catch (err) {
          console.error(err);
          alert('Network error whilst saving.');
          submitBtn.innerText = originalText;
          submitBtn.disabled = false;
        }
      });
    </script>
  </body>
</html>
